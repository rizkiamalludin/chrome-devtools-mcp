{
  "name": "rizki-browser-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, deterministic browser MCP server powered by Playwright and Browserbase.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@browserbasehq/sdk": "2.24.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "tsx": "4.20.3",
    "typescript": "5.6.3"
  }
}
