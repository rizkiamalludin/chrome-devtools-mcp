# Copy this file to .env and fill values locally. Never commit .env.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# stdio for local MCP clients; http for a private remote deployment.
TRANSPORT=stdio

# Required only when TRANSPORT=http. Generate a long random token locally.
MCP_AUTH_TOKEN=

# Optional comma-separated host header allowlist for remote hosting.
ALLOWED_HOSTS=